generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients RecipeIngredient[]
  steps       RecipeStep[]

  planItems PlanItem[]
  groceryLists GroceryListRecipe[]
}


model Ingredient {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  usedIn       RecipeIngredient[]
  groceryItems GroceryItem[]
}

model RecipeIngredient {
  id           String @id @default(cuid())
  recipeId     String
  ingredientId String

  amount   Float?
  unit     String?
  optional Boolean @default(false)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
}

model RecipeStep {
  id       String @id @default(cuid())
  recipeId String
  order    Int
  text     String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, order])
}

model Plan {
  id        String   @id @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PlanItem[]
}

model PlanItem {
  id       String @id @default(cuid())
  planId   String
  recipeId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([planId, recipeId])
}

model GroceryItem {
  id            String @id @default(cuid())
  groceryListId String
  ingredientId  String

  amount  Float?
  unit    String?
  checked Boolean @default(false)

  groceryList GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  ingredient  Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([groceryListId])
}

model GroceryList {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     GroceryItem[]
  recipes   GroceryListRecipe[]   // <-- MUST be exactly this (name "recipes")
}


model GroceryListRecipe {
  id            String     @id @default(cuid())
  groceryListId String
  recipeId      String

  groceryList GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  recipe      Recipe      @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@unique([groceryListId, recipeId])
}

